ANTHROPIC_API_KEY=your-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Which LLM provider to use for post extraction (POST /capture): "anthropic" or "groq"
LLM_PROVIDER=anthropic

# GROQ_API_KEY is required for the "Draft Email" action (POST /generate-email)
# regardless of LLM_PROVIDER above -- email drafting always calls Groq directly.

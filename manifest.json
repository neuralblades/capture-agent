{
  "manifest_version": 3,
  "name": "Capture Agent",
  "version": "0.1.0",
  "description": "Capture posts from X.com and LinkedIn, or any selected text on the web, and hand them off to Capture Agent's AI workflows.",
  "permissions": ["activeTab","storage", "sidePanel", "contextMenus"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://*.linkedin.com/*", "https://github.com/*", "https://docs.google.com/forms/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "extension/background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "extension/sidepanel/sidepanel.html"
  },
  "options_page": "extension/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "extension/content/selectors.js",
        "extension/content/types.js",
        "extension/content/extract.js",
        "extension/content/messaging.js",
        "extension/content/injector.js",
        "extension/content/observer.js",
        "extension/content/content.js"
      ],
      "css": ["extension/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["extension/content/form_autofill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["extension/content/universal_autofill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["extension/content/linkedin.js"],
      "css": ["extension/content/linkedin.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["extension/content/github.js"],
      "css": ["extension/content/github.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Capture Agent"
  }
}
